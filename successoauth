<!DOCTYPE html>
<html>
<head>
    <script>
        // Extract query params and redirect to app
        const urlParams = new URLSearchParams(window.location.search);
        const userId = urlParams.get('userId');
        const secret = urlParams.get('secret');
        
        if (userId && secret) {
            // Redirect to app with custom scheme
            window.location.href = `myordr://oauth-success?userId=${userId}&secret=${secret}`;
        } else {
            window.location.href = 'myordr://oauth-success';
        }
    </script>
</head>
<body>
    <p>Redirecting to app...</p>
</body>
</html> 
